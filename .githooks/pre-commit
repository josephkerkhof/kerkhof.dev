#!/usr/bin/env bash
set -euo pipefail

project_root="$(git rev-parse --show-toplevel)"
cd "$project_root"

failed=0
while IFS= read -r -d '' file; do
  # Read the index, not the working tree: unstaged writing must stay untouched.
  if ! git show ":$file" | bash "$project_root/scripts/prettier.sh" \
    --check --stdin-filepath "$file"; then
    failed=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.md')

if [[ "$failed" -ne 0 ]]; then
  printf '\n%s\n' \
    'Staged Markdown formatting needs attention.' \
    'Run `make format`, review the changes, then stage and commit again.' \
    'The hook has not modified any files or staged any changes.' >&2
  exit 1
fi
